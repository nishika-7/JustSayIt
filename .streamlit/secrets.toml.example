# Copy to .streamlit/secrets.toml for local runs, or paste into Streamlit Cloud > App settings > Secrets
ANTHROPIC_API_KEY = "your-key-here"
MODEL_NAME = "claude-sonnet-5-5"
# Optional demo limits (defaults: 6 per visitor session, 300 total per app process)
MAX_RUNS_PER_SESSION = "6"
MAX_RUNS_GLOBAL = "300"
